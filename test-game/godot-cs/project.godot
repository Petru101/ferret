config_version=5

[application]

config/name="Ferret Godot C# stand-in"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "C#")

[display]

window/size/viewport_width=640
window/size/viewport_height=280

[dotnet]

project/assembly_name="StandinCs"

[rendering]

renderer/rendering_method="gl_compatibility"
