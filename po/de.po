#: src/gui/guide.rs:77
msgid "Pick the number"
msgstr "Zahl wählen"

#: src/gui/guide.rs:77
msgid "Hands off"
msgstr "Finger weg"

#: src/gui/guide.rs:77
msgid "Change it"
msgstr "Ändern"

#: src/gui/guide.rs:77
msgid "Checking"
msgstr "Prüfen"

#: src/gui/guide.rs:129
msgid "Hands off: don't change anything in the game yet"
msgstr "Finger weg: Ändere noch nichts im Spiel"

#: src/gui/guide.rs:256
#, rust-format
msgid "{step}. Ferret tells you when it's your turn."
msgstr "{step}. Ferret sagt dir, wenn du dran bist."

#: src/gui/guide.rs:369
#, rust-format
msgid "Scanning the game's memory for {n}"
msgstr "Speicher des Spiels wird nach {n} durchsucht"

#: src/gui/guide.rs:382
msgid ""
"Don't let the icons change in the game yet. This turns green when it's your "
"turn."
msgstr ""
"Lass die Symbole sich im Spiel noch nicht ändern. Das hier wird grün, wenn "
"du dran bist."

#: src/gui/guide.rs:383
msgid ""
"Don't let the bar change in the game yet. This turns green when it's your "
"turn."
msgstr ""
"Lass den Balken sich im Spiel noch nicht ändern. Das hier wird grün, wenn du "
"dran bist."

#: src/gui/guide.rs:391 src/gui/guide.rs:413
msgid "Now let the icons change in the game"
msgstr "Lass jetzt die Symbole sich im Spiel ändern"

#: src/gui/guide.rs:391
msgid "Ready: let the icons change in the game"
msgstr "Bereit: Lass die Symbole sich im Spiel ändern"

#: src/gui/guide.rs:392 src/gui/guide.rs:412
msgid "Now let the bar change in the game"
msgstr "Lass jetzt den Balken sich im Spiel ändern"

#: src/gui/guide.rs:392
msgid "Ready: let the bar change in the game"
msgstr "Bereit: Lass den Balken sich im Spiel ändern"

#: src/gui/guide.rs:394
msgid "Take a hit, or use some. Every change narrows it down."
msgstr ""
"Steck einen Treffer ein oder verbrauche etwas. Jede Änderung grenzt es ein."

#: src/gui/guide.rs:402
msgid "Keep the bar changing in the game"
msgstr "Lass den Balken sich im Spiel weiter ändern"

#: src/gui/guide.rs:403
msgid "Keep the icons changing in the game"
msgstr "Lass die Symbole sich im Spiel weiter ändern"

#: src/gui/guide.rs:404
msgid "Keep changing the number in the game"
msgstr "Ändere die Zahl im Spiel weiter"

#: src/gui/guide.rs:412
msgid "Ready: keep the bar changing in the game"
msgstr "Bereit: Lass den Balken sich im Spiel weiter ändern"

#: src/gui/guide.rs:413
msgid "Ready: keep the icons changing in the game"
msgstr "Bereit: Lass die Symbole sich im Spiel weiter ändern"

#: src/gui/guide.rs:414
msgid "Ready: change the number in the game"
msgstr "Bereit: Ändere die Zahl im Spiel"

#: src/gui/guide.rs:416 src/gui/guide.rs:432
#, rust-format
msgid "{n} place matches. Every change narrows it down."
msgid_plural "{n} places match. Every change narrows it down."
msgstr[0] "{n} Stelle passt. Jede Änderung grenzt es ein."
msgstr[1] "{n} Stellen passen. Jede Änderung grenzt es ein."

#: src/gui/guide.rs:426
#, rust-format
msgid "{before} → {n} place matches. Every change narrows it down."
msgid_plural "{before} → {n} places match. Every change narrows it down."
msgstr[0] "{before} → {n} Stelle passt. Jede Änderung grenzt es ein."
msgstr[1] "{before} → {n} Stellen passen. Jede Änderung grenzt es ein."

#: src/gui/guide.rs:445
#, rust-format
msgid "Got it: {before} → {n} place matches"
msgid_plural "Got it: {before} → {n} places match"
msgstr[0] "Verstanden: {before} → {n} Stelle passt"
msgstr[1] "Verstanden: {before} → {n} Stellen passen"

#: src/gui/guide.rs:463
msgid "It's moving: Ferret watches the game"
msgstr "Bewegt sich: Ferret beobachtet das Spiel"

#: src/gui/guide.rs:464
msgid "It's still: Ferret watches the game"
msgstr "Steht still: Ferret beobachtet das Spiel"

#: src/gui/guide.rs:465
#, rust-format
msgid "It's moving: {n} place follows it"
msgid_plural "It's moving: {n} places follow it"
msgstr[0] "Bewegt sich: {n} Stelle folgt ihm"
msgstr[1] "Bewegt sich: {n} Stellen folgen ihm"

#: src/gui/guide.rs:466
#, rust-format
msgid "It's still: {n} place follows it"
