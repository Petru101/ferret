msgstr "DEINE WAHL"

#: src/gui/guide.rs:52
msgid "HANDS OFF"
msgstr "FINGER WEG"

#: src/gui/guide.rs:53
msgid "YOUR TURN"
msgstr "DU BIST DRAN"

#: src/gui/guide.rs:54
msgid "YOUR CALL"
msgstr "DEINE ENTSCHEIDUNG"

#: src/gui/guide.rs:55
msgid "FOUND"
msgstr "GEFUNDEN"

