msgstr "Ne touchez à rien"

#: src/gui/guide.rs:77
msgid "Change it"
msgstr "Le modifier"

#: src/gui/guide.rs:77
msgid "Checking"
msgstr "Vérification"

#: src/gui/guide.rs:121
