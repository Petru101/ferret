msgstr "Types de valeurs que cherchent les nouvelles recherches :"

#: src/gui/find.rs:464
msgid "Learned digits:"
msgstr "Chiffres appris :"

#: src/gui/find.rs:470
msgid "Forget Them"
msgstr "Les oublier"

#: src/gui/find.rs:471
msgid "Search everywhere instead, until the next value found"
msgstr "Chercher partout à la place, jusqu'à la prochaine valeur trouvée"

