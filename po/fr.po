msgid "its pointer paths lead nowhere right now, waiting"
msgstr ""
"ses chemins de pointeurs ne mènent nulle part pour l'instant, en attente"

#: src/gui/values.rs:49
msgid "looking for it by name"
msgstr "recherche par son nom"

#: src/gui/values.rs:50
msgid "it isn't anywhere right now (none in the game?), waiting"
msgstr ""
"elle n'est nulle part pour l'instant (aucune dans le jeu ?), en attente"

#: src/gui/values.rs:51
msgid "its name leads to places that aren't one value, not written"
msgstr ""
"son nom mène à des emplacements qui ne sont pas une seule valeur, non écrite"

#: src/gui/values.rs:52
msgid "the object holding it changed, finding it again"
msgstr "l'objet qui la contient a changé, nouvelle recherche"

#: src/gui/values.rs:53
