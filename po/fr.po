msgstr "Ne touchez à rien : ne modifiez encore rien dans le jeu"

#: src/gui/guide.rs:246
#, rust-format
msgid "{step}. Ferret tells you when it's your turn."
msgstr "{step}. Ferret vous prévient quand c'est votre tour."

#: src/gui/guide.rs:348
#, rust-format
msgid "Scanning the game's memory for {n}"
msgstr "Recherche de {n} dans la mémoire du jeu"

#: src/gui/guide.rs:361
msgid ""
"Don't let the icons change in the game yet. This turns green when it's your "
"turn."
msgstr ""
"Ne laissez pas encore les icônes changer dans le jeu. Ceci devient vert "
"quand c'est votre tour."

#: src/gui/guide.rs:362
msgid ""
"Don't let the bar change in the game yet. This turns green when it's your "
"turn."
msgstr ""
"Ne laissez pas encore la barre changer dans le jeu. Ceci devient vert quand "
"c'est votre tour."

#: src/gui/guide.rs:370 src/gui/guide.rs:392
msgid "Now let the icons change in the game"
msgstr "Laissez maintenant les icônes changer dans le jeu"

#: src/gui/guide.rs:370
msgid "Ready: let the icons change in the game"
msgstr "Prêt : laissez les icônes changer dans le jeu"

#: src/gui/guide.rs:371 src/gui/guide.rs:391
msgid "Now let the bar change in the game"
msgstr "Laissez maintenant la barre changer dans le jeu"

#: src/gui/guide.rs:371
msgid "Ready: let the bar change in the game"
msgstr "Prêt : laissez la barre changer dans le jeu"

#: src/gui/guide.rs:373
msgid "Take a hit, or use some. Every change narrows it down."
msgstr ""
"Prenez un coup, ou utilisez-en. Chaque changement réduit les possibilités."

#: src/gui/guide.rs:381
msgid "Keep the bar changing in the game"
msgstr "Continuez à faire changer la barre dans le jeu"

#: src/gui/guide.rs:382
msgid "Keep the icons changing in the game"
msgstr "Continuez à faire changer les icônes dans le jeu"

#: src/gui/guide.rs:383
msgid "Keep changing the number in the game"
msgstr "Continuez à modifier le nombre dans le jeu"

#: src/gui/guide.rs:391
msgid "Ready: keep the bar changing in the game"
msgstr "Prêt : continuez à faire changer la barre dans le jeu"

#: src/gui/guide.rs:392
msgid "Ready: keep the icons changing in the game"
msgstr "Prêt : continuez à faire changer les icônes dans le jeu"

#: src/gui/guide.rs:393
msgid "Ready: change the number in the game"
msgstr "Prêt : modifiez le nombre dans le jeu"

#: src/gui/guide.rs:395 src/gui/guide.rs:411
#, rust-format
msgid "{n} place matches. Every change narrows it down."
msgid_plural "{n} places match. Every change narrows it down."
msgstr[0] ""
"{n} emplacement correspond. Chaque changement réduit les possibilités."
msgstr[1] ""
"{n} emplacements correspondent. Chaque changement réduit les possibilités."

#: src/gui/guide.rs:405
#, rust-format
msgid "{before} → {n} place matches. Every change narrows it down."
msgid_plural "{before} → {n} places match. Every change narrows it down."
msgstr[0] ""
"{before} → {n} emplacement correspond. Chaque changement réduit les "
"possibilités."
msgstr[1] ""
"{before} → {n} emplacements correspondent. Chaque changement réduit les "
"possibilités."

#: src/gui/guide.rs:424
#, rust-format
msgid "Got it: {before} → {n} place matches"
msgid_plural "Got it: {before} → {n} places match"
msgstr[0] "Compris : {before} → {n} emplacement correspond"
msgstr[1] "Compris : {before} → {n} emplacements correspondent"

#: src/gui/guide.rs:460
#, rust-format
msgid ""
"Scanned again: still {n} place matches. Keep changing it, or press Scan "
"Again while it stays the same."
msgid_plural ""
"Scanned again: still {n} places match. Keep changing it, or press Scan Again "
"while it stays the same."
msgstr[0] ""
"Nouvelle recherche : toujours {n} emplacement qui correspond. Continuez à le "
"modifier, ou appuyez sur Rechercher à nouveau tant qu'il reste le même."
msgstr[1] ""
"Nouvelle recherche : toujours {n} emplacements qui correspondent. Continuez "
"à le modifier, ou appuyez sur Rechercher à nouveau tant qu'il reste le même."

#: src/gui/guide.rs:466
#, rust-format
msgid ""
"Scanned again: {before} → {n} place matches. Keep changing it, or press Scan "
