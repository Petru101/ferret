msgstr "Wypróbuj"

#: src/gui/find.rs:383
msgid "Skip"
msgstr "Pomiń"

#: src/gui/find.rs:384
msgid "Stop Trying"
msgstr "Przestań próbować"

#: src/gui/find.rs:392
