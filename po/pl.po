msgstr "Wypróbuj je po kolei"

#: src/gui/find.rs:365
msgid "Keep Going"
msgstr "Kontynuuj"

#: src/gui/find.rs:366
msgid "Change the number in the game again: often the quicker way"
msgstr "Zmień liczbę w grze ponownie: często tak jest szybciej"

#: src/gui/find.rs:369
msgid "Show the List"
msgstr "Pokaż listę"

#: src/gui/find.rs:380
