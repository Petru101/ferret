msgstr "Wykluczyć to miejsce?"

#: src/gui/find.rs:233
#, rust-format
msgid ""
"{place} ({kind}, now {value}) is dropped from the matches. Undo brings it "
"back."
msgstr ""
"{place} ({kind}, teraz {value}) zostaje usunięte z dopasowań. Cofnij je "
"przywraca."

#: src/gui/find.rs:239
msgid "Rule Out"
msgstr "Wyklucz"

#: src/gui/find.rs:261
