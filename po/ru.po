msgstr "Готово: продолжайте менять полосу в игре"

#: src/gui/guide.rs:392
msgid "Ready: keep the icons changing in the game"
msgstr "Готово: продолжайте менять значки в игре"

#: src/gui/guide.rs:393
msgid "Ready: change the number in the game"
msgstr "Готово: измените число в игре"

#: src/gui/guide.rs:395 src/gui/guide.rs:411
#, rust-format
msgid "{n} place matches. Every change narrows it down."
msgid_plural "{n} places match. Every change narrows it down."
msgstr[0] "Подходит {n} место. Каждое изменение сужает поиск."
msgstr[1] "Подходят {n} места. Каждое изменение сужает поиск."
msgstr[2] "Подходят {n} мест. Каждое изменение сужает поиск."

#: src/gui/guide.rs:405
#, rust-format
msgid "{before} → {n} place matches. Every change narrows it down."
msgid_plural "{before} → {n} places match. Every change narrows it down."
msgstr[0] "{before} → подходит {n} место. Каждое изменение сужает поиск."
msgstr[1] "{before} → подходят {n} места. Каждое изменение сужает поиск."
msgstr[2] "{before} → подходят {n} мест. Каждое изменение сужает поиск."

#: src/gui/guide.rs:424
#, rust-format
msgid "Got it: {before} → {n} place matches"
msgid_plural "Got it: {before} → {n} places match"
msgstr[0] "Принято: {before} → подходит {n} место"
msgstr[1] "Принято: {before} → подходят {n} места"
msgstr[2] "Принято: {before} → подходят {n} мест"

#: src/gui/guide.rs:460
#, rust-format
msgid ""
"Scanned again: still {n} place matches. Keep changing it, or press Scan "
"Again while it stays the same."
msgid_plural ""
"Scanned again: still {n} places match. Keep changing it, or press Scan Again "
"while it stays the same."
msgstr[0] ""
"Повторное сканирование: по-прежнему подходит {n} место. Продолжайте менять "
"число или нажимайте «Сканировать снова», пока оно не меняется."
msgstr[1] ""
"Повторное сканирование: по-прежнему подходят {n} места. Продолжайте менять "
"число или нажимайте «Сканировать снова», пока оно не меняется."
msgstr[2] ""
"Повторное сканирование: по-прежнему подходят {n} мест. Продолжайте менять "
"число или нажимайте «Сканировать снова», пока оно не меняется."

#: src/gui/guide.rs:466
#, rust-format
msgid ""
"Scanned again: {before} → {n} place matches. Keep changing it, or press Scan "
"Again while it stays the same."
msgid_plural ""
"Scanned again: {before} → {n} places match. Keep changing it, or press Scan "
"Again while it stays the same."
msgstr[0] ""
"Повторное сканирование: {before} → подходит {n} место. Продолжайте менять "
"число или нажимайте «Сканировать снова», пока оно не меняется."
msgstr[1] ""
"Повторное сканирование: {before} → подходят {n} места. Продолжайте менять "
