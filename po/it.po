msgid "Renamed {name} to {to}"
msgstr "{name} rinominato in {to}"

#: src/gui/values.rs:172
#, rust-format
msgid "Remove {name}?"
msgstr "Rimuovere {name}?"

#: src/gui/values.rs:173
msgid ""
"Ferret stops finding it and keeping it in range. The number in the game "
"stays as it is."
msgstr ""
"Ferret smette di trovarlo e di mantenerlo nell'intervallo. Il numero nel "
"gioco resta com'è."

#: src/gui/values.rs:175 src/gui/values.rs:341
msgid "Remove"
msgstr "Rimuovi"

#: src/gui/values.rs:182
#, rust-format
msgid "Removed {name}"
msgstr "{name} rimosso"

#: src/gui/values.rs:198
msgid "No Saved Values Yet"
msgstr "Ancora nessun valore salvato"

#: src/gui/values.rs:199
msgid ""
"Find a value in the game and save it. Saved values are found again "
"automatically every time you attach."
msgstr ""
"Trova un valore nel gioco e salvalo. I valori salvati vengono ritrovati "
"automaticamente ogni volta che ti colleghi."

#: src/gui/values.rs:255
#, rust-format
msgid ""
"Saved in an earlier run, {kind}. Find it again and save it with the same "
"name to see it."
msgstr ""
"Salvato in un'esecuzione precedente, {kind}. Trovalo di nuovo e salvalo con "
"lo stesso nome per vederlo."

#: src/gui/values.rs:256
#, rust-format
msgid "Not in the game right now (none of it, or no save loaded), {kind}."
msgstr ""
"Ora non è nel gioco (non ce n'è, o nessun salvataggio caricato), {kind}."

#: src/gui/values.rs:259
#, rust-format
msgid "At {place}, {kind}, shown with {n} decimal."
msgid_plural "At {place}, {kind}, shown with {n} decimals."
msgstr[0] "A {place}, {kind}, mostrato con {n} decimale."
msgstr[1] "A {place}, {kind}, mostrato con {n} decimali."

#: src/gui/values.rs:265
#, rust-format
msgid "At {place}, {kind}."
msgstr "A {place}, {kind}."

#: src/gui/values.rs:270
#, rust-format
msgid "Kept in {n} place (every stack): setting it sets each."
msgid_plural "Kept in {n} places (every stack): setting it sets each."
msgstr[0] ""
"Mantenuto in {n} posizione (ogni pila): impostarlo le imposta tutte."
msgstr[1] ""
"Mantenuto in {n} posizioni (ogni pila): impostarlo le imposta tutte."

#: src/gui/values.rs:276
msgid ""
"Imported, not checked yet: if the game shows this number, say so below. "
"Ferret won't change it until then."
msgstr ""
"Importato, non ancora controllato: se il gioco mostra questo numero, dillo "
"qui sotto. Ferret non lo cambierà fino ad allora."

#: src/gui/values.rs:278
msgid "Not confirmed yet: if the game shows this number, say so below."
msgstr ""
"Non ancora confermato: se il gioco mostra questo numero, dillo qui sotto."

#: src/gui/values.rs:280
msgid "Not confirmed yet: restart the game, then check the number here."
msgstr "Non ancora confermato: riavvia il gioco, poi controlla il numero qui."

#: src/gui/values.rs:283
#, rust-format
msgid "Not written right now: {why}."
msgstr "Non scritto in questo momento: {why}."

#: src/gui/values.rs:286
msgid ""
"Java game: only shown. Java moves its objects, so a write could land in "
"another one and crash the game."
msgstr ""
"Gioco Java: solo mostrato. Java sposta i suoi oggetti, quindi una scrittura "
"potrebbe finire in un altro e far bloccare il gioco."

#: src/gui/values.rs:312
#, rust-format
msgid "Does the game show {n}?"
msgstr "Il gioco mostra {n}?"

#: src/gui/values.rs:315
msgid ""
"Then Ferret can change it and keep it in range. If it shows another number, "
"remove it and find it yourself."
msgstr ""
"Allora Ferret può cambiarlo e mantenerlo nell'intervallo. Se mostra un altro "
"numero, rimuovilo e trovalo tu."

#: src/gui/values.rs:373 src/gui/values.rs:484
msgid "Value"
msgstr "Valore"

#: src/gui/values.rs:379
msgid "Keep It This Way"
msgstr "Tienilo così"

